{
  "dependencies": {
    "@kos-kit/sparql-client": "2.0.116",
    "@rdfjs/term-set": "^2.0.3",
    "@rdfjs/types": "^1.1.0",
    "@tpluscode/rdf-ns-builders": "^4.3.0",
    "@types/rdfjs__term-set": "^2.0.9",
    "@types/n3": "^1.26.0",
    "@types/sparqljs": "3.1.12",
    "js-sha256": "^0.11.0",
    "n3": "^1.26.0",
    "purify-ts": "~2.1.0",
    "sparqljs": "3.7.3",
    "rdfjs-resource": "1.0.25"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tsconfig/node18": "^18.2.4",
    "@tsconfig/strictest": "^2.0.5",
    "depcheck": "^1.4.7",
    "rimraf": "^6.0.1",
    "typescript": "5.8.2",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  },
  "files": [
    "dist/dist/*.d.ts",
    "dist/dist/*.js",
    "dist/dist/*.ttl",
    "dist/src/*.d.ts",
    "dist/src/*.js",
    "dist/src/*.ttl"
  ],
  "main": "./dist/index.js",
  "license": "Apache-2.0",
  "name": "@kos-kit/models",
  "packageManager": "npm@10.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kos-kit/lib"
  },
  "scripts": {
    "build": "tsc -b",
    "build:noEmit": "tsc --noEmit",
    "check": "biome check",
    "check:write": "biome check --write",
    "check:write:unsafe": "biome check --write --unsafe",
    "clean": "rimraf -g **/*.d.ts* **/*.js **/*.js.map tsconfig.tsbuildinfo",
    "depcheck": "depcheck .",
    "dev": "tsc -w --preserveWatchOutput",
    "dev:noEmit": "tsc --noEmit -w --preserveWatchOutput",
    "link-dependencies": "npm link rdfjs-resource",
    "test": "biome check && vitest run",
    "test:coverage": "biome check && vitest run --coverage",
    "test:watch": "vitest watch",
    "unlink": "npm unlink -g @kos-kit/models"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "2.0.116"
}
